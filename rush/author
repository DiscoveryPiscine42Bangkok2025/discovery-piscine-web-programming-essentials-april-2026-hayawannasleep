<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile card</title>
    <style>
        body {
         display: flex;
         flex-direction: column;
         align-items: center;
         min-height: 100vh;
         margin: 0;
         background: #f4f4f9
         padding: 30px;
        }

        body{
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background-color: #f4f4f9;
            padding: 30px;
        }
        h1{
            width:100%;
            text-align: center;
            margin-bottom: 30px;
            font-size: 100px;
        }
        .card-container{
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
            justify-content: center;
        }
    .profile-card{
        width: 300px;
        padding: 20px;
        background-color: whitesmoke;
        border: 1px solid #ddd;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        text-align: center;
        font-family: arial,sans serif;
    }
    .profile-pic{
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
    }

    .contact-btn {
        background-color: #ff9cba;
        color: white;
        border: 2px solid #ffdfe8;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        cursor: pointer;
        margin-top: 15px;
        display: inline-block;
        text-decoration: none;
    }
    .contact-btn:hover{
        background-color: #ffafc7;
    }
    table{
        width: 100%;
        margin: 0 auto;
    }

    </style>
    </head>
    <body>
        <h1>Portfolio</h1>
        <div class="card-container">

     <div class="profile-card">
        <h2>My profile</h2>
        <table border="0" cellspacing="0" cellpadding="10">
            <tr>
                <td align="center">
                    <img src="np.jpg" alt="Profile picture" class="profile-pic">
                </td>
            </tr>
            <tr>
             <td align="center">
                <h3 style="margin: 0;">@Napat</h3>
             </td>
            </tr>
            <tr>
             <td align="center">
                <p style="margin: 0; color: gray;"> Kinda nervous</p>
             </td>
            </tr>
           </table>
            <a href="contact.html" target="_blank" class="contact-btn">Contact</a>
     </div>
     <div class="profile-card">
            <h2>My profile</h2>
            <table border="0" cellspacing="0" cellpadding="10">
                <tr>
                    <td align="center">
                        <img src="varin.jpg" alt="Profile picture" class="profile-pic">
                    </td>
                </tr>
                <tr>
                    <td align="center">
                        <h3 style="margin: 0;">@Varin</h3>
                    </td>
                </tr>
                <tr>
                    <td align="center">
                        <p style="margin: 0; color: gray;">Also nervous</p>
                    </td>
                </tr>
            </table>
            <a href="contact2.html" target="_blank" class="contact-btn">Contact</a>
        </div>

    </div>
</body>
</html>
